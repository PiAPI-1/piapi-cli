{
  "name": "piapi-cli",
  "version": "0.2.0",
  "description": "Official CLI for the PiAPI platform — call 97 multimodal AI models (image, video, audio, 3D, LLM) from your terminal or AI agent",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "piapi": "dist/piapi.mjs"
  },
  "files": [
    "dist/piapi.mjs"
  ],
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun run build.ts",
    "lint": "eslint src/ test/ --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "piapi",
    "cli",
    "ai",
    "multimodal",
    "image-generation",
    "video-generation",
    "tts",
    "music-generation",
    "flux",
    "midjourney",
    "kling",
    "sora",
    "veo",
    "agent-skill"
  ],
  "homepage": "https://piapi.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/PiAPI-1/piapi-cli.git"
  },
  "bugs": {
    "url": "https://github.com/PiAPI-1/piapi-cli/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "eslint": "^9.24.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0"
  }
}
